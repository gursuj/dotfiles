#!/bin/bash
# Workaround for omarchy #13812/#18689: BenQ drops HDMI hotplug on DPMS off,
# lock re-arms its blank timer, both screens cycle until unlock.
# While locked: disable HDMI output so its hotplug is ignored. On unlock: restore.
# Polls lock state (no lock-state event exists on the hypr socket).

OUT=HDMI-A-1
saved=""

state() { omarchy-shell lock isLocked 2>/dev/null; }

while sleep 1; do
  s=$(state)
  if [ "$s" = "true" ] && [ -z "$saved" ]; then
    # Save geometry so a panel scale change survives the round trip.
    saved=$(hyprctl monitors -j | jq -r --arg o "$OUT" \
      '.[] | select(.name==$o) | "\(.width)x\(.height)@\(.refreshRate) \(.scale)"')
    [ -n "$saved" ] || continue
    # Workspaces on HDMI, so they (and their windows) can go back after unlock.
    wss=$(hyprctl workspaces -j | jq -r --arg o "$OUT" '.[] | select(.monitor==$o) | .id')
    hyprctl eval "hl.monitor({ output = \"$OUT\", disabled = true })" >/dev/null
    sleep 0.5
    hyprctl dispatch 'hl.dsp.dpms({ action = "disable" })' >/dev/null
  elif [ "$s" = "false" ] && [ -n "$saved" ]; then
    mode=${saved% *}; scale=${saved#* }
    hyprctl eval "hl.monitor({ output = \"$OUT\", disabled = false, mode = \"$mode\", position = \"auto-up\", scale = $scale, reserved = { bottom = 40 } })" >/dev/null
    hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null
    sleep 2
    for id in $wss; do
      hyprctl dispatch "hl.dsp.workspace.move({ workspace = \"$id\", monitor = \"$OUT\" })" >/dev/null
    done
    saved=""; wss=""
  fi
done
