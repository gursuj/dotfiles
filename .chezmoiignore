{{ if ne .machine_kind "t14" }}
## t14 only 

# kanata's systemd --user autostart is specific to this physical keyboard's
# Linux box -- no hardware keyboard to remap on the VPS, and Windows
# autostarts kanata a different way (not systemd).
.config/systemd/user/kanata.service
# Desktop/Wayland/pacman-specific aliases -- only sourced when
# machine_kind == t14 (dot_zshrc.tmpl), no point deploying elsewhere.
.config/shell/arch-aliasrc
# Only tracked for the arch box's Local by Flywheel wp-cli fix so far (see
# TODO.md's bash-on-vps note) -- not a general bashrc consolidation yet, so
# don't deploy it to the vps or elsewhere.
.bashrc
# local-wpcli (Local by Flywheel wp-cli fix) and its ~/.local/bin/wpl symlink,
# plus cleanGradle (gradle cache cleanup) -- laptop-only tools, not needed on the
# vps or windows.
.config/shell/local-wpcli
.config/shell/cleanGradle
.local/bin/wpl
# battbench: laptop battery/power benchmark, needs BAT0 + systemd -- not for vps/windows.
.local/bin/battbench
# bitwarden-popout: Hyprland + Linux Firefox profile paths only.
.local/bin/bitwarden-popout
# battery charge notifications (low + charge-limit reached) -- laptop hardware
# and the t14's systemd --user autostart, so not for vps/windows either.
.local/bin/omarchy-battery-notify
.config/systemd/user/omarchy-battery-notify.service
# GUI/laptop-only apps and the ssh config (hosts only, encrypted; keys are never
# tracked). Windows has different config paths for these, so not deployed there yet.
.config/ghostty
.config/sioyek
.config/yay
.config/obs-studio
.config/mindwtr
.config/uwsm
.config/fontconfig
.ssh
{{ end }}

{{ if eq .machine_kind "t14" }}
## never deploy on the t14

# nvim: the t14 runs Omarchy's own LazyVim setup (~/.config/nvim with
# lua/plugins/{theme,omarchy-theme-hotreload,remote_clipboard}.lua), themed live
# from ~/.local/state/omarchy/current/theme/neovim.lua. The tracked config here
# is the old hand-built one and would replace all of that wholesale. Deliberately
# not deployed while LazyVim is being tried -- see learnings.md.
.config/nvim
# hyprland.lua is Omarchy's entry point (it pulls in default.hypr.* plus the
# user files below). Tracked here only if you accept syncing it by hand against
# Omarchy releases -- deliberately left to the package for now. The user-owned
# files next to it (bindings/looknfeel/autostart/monitors/hyprsunset.conf) are
# tracked and do deploy.
.config/hypr/hyprland.lua
{{ end }}

