#!/bin/sh
# Installs Claude Code plugins from desired-plugins.txt (one
# "owner/repo plugin-id@marketplace-name" pair per line).
#
# claude plugin marketplace add / plugin install are both idempotent on their
# own (exit 0, "already on disk" / "already installed" note) -- confirmed by
# hand against an already-installed plugin, unlike herdr's install which
# needs the error-swallow trick. So this just runs both commands for every
# line and doesn't special-case "already present".
#
# Figma and wp-creative predate this pattern (installed by hand, or via the
# wpc-client-setup skill) and aren't retrofitted into desired-plugins.txt
# here -- this file only covers plugins onboarded through this script from
# here on. See README's "Plugin-manager tools" section.
#
# desired plugins hash: {{ include "dot_claude/desired-plugins.txt" | sha256sum }}

if ! command -v claude >/dev/null 2>&1; then
  echo "claude not found on PATH, skipping plugin install" >&2
  exit 0
fi

desired="{{ .chezmoi.homeDir }}/.claude/desired-plugins.txt"

if [ ! -f "$desired" ]; then
  echo "desired-plugins.txt not found at $desired, skipping plugin install" >&2
  exit 0
fi

while IFS=' ' read -r repo pluginref; do
  [ -n "$repo" ] || continue
  if ! out="$(claude plugin marketplace add "$repo" 2>&1)"; then
    echo "$repo: marketplace add failed: $out" >&2
    continue
  fi
  if ! out="$(claude plugin install "$pluginref" 2>&1)"; then
    echo "$pluginref: install failed: $out" >&2
    continue
  fi
  echo "$pluginref: ok"
done < "$desired"
