#!/bin/sh
# Reruns whenever ~/.config/yazi/package.toml's content changes (including the
# first-ever apply on a new machine), so declared yazi plugins actually get
# installed instead of just sitting in package.toml unfetched.
# package.toml hash: {{ include "dot_config/yazi/package.toml" | sha256sum }}

if command -v ya >/dev/null 2>&1; then
  ya pkg install
else
  echo "ya (yazi) not found on PATH, skipping plugin install" >&2
fi
