#!/bin/sh
# Installs plugins from desired-plugins.txt (one owner/repo per line).
# Generated by scripts/sync-yazi-plugins.sh, not hand-edited -- see README.
#
# Not reading package.toml directly: ya rewrites its hash per machine, and
# it's local-only anyway (nothing to sync to other devices from it).
#
# ya pkg add errors on already-declared plugins, so skip those; pkg install
# after is safe always, catches anything declared but not yet fetched.
#
# desired plugins hash: {{ include "dot_config/yazi/desired-plugins.txt" | sha256sum }}

if ! command -v ya >/dev/null 2>&1; then
  echo "ya (yazi) not found on PATH, skipping plugin install" >&2
  exit 0
fi

config_home="${YAZI_CONFIG_HOME:-$HOME/.config/yazi}"
desired="$config_home/desired-plugins.txt"
pkg_toml="$config_home/package.toml"

if [ ! -f "$desired" ]; then
  echo "desired-plugins.txt not found at $desired, skipping plugin install" >&2
  exit 0
fi

while IFS= read -r plugin; do
  [ -n "$plugin" ] || continue
  if [ -f "$pkg_toml" ] && grep -q "use = \"$plugin\"" "$pkg_toml"; then
    continue
  fi
  ya pkg add "$plugin"
done < "$desired"

ya pkg install
