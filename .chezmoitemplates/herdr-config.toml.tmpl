# Run `herdr --default-config` to see all available settings and their defaults.
# This dumps the defaults compiled into whatever herdr binary is currently
# installed locally — it does not fetch from upstream. Run `herdr update` first
# if you want the dump to reflect the latest release.

onboarding = false
[update]
channel = "preview"

[terminal]
{{- if eq .chezmoi.os "windows" }}
# Hardcoded — herdr's Windows support is still beta and doesn't actually read
# $SHELL there (confirmed by testing: set + rebooted, still fell back to
# PowerShell 5). $SHELL works fine on Linux/Mac so it's left to the fallback
# there; see README for the full story.
default_shell = "C:\\Program Files\\PowerShell\\7\\pwsh.exe"
{{- else }}
# default_shell unset — falls back to $SHELL, which works correctly on Unix.
{{- end }}
new_cwd = "follow"

[keys]
prefix = "ctrl+x"
next_agent = "prefix+tab"
previous_agent = "prefix+shift+tab"
settings = "prefix+comma"
workspace_picker = "prefix+shift+w"
rename_workspace = "prefix+shift+e"
previous_workspace = "prefix+w"
next_workspace = "prefix+s"

{{- if eq .chezmoi.os "windows" }}

[[keys.command]]
key = "prefix+n"
type = "shell"
command = 'pwsh -NoProfile -File "C:\Users\User\scripts\herdr-new-cc-tab.ps1"'
{{- end }}

[ui]
agent_panel_sort = "spaces"

[ui.toast]
delivery = "herdr"

[theme]
name = "nord"
auto_switch = false

[experimental]
kitty_graphics = true
