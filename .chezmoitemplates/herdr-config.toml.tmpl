# Run `herdr --default-config` to see all available settings and their defaults.
# This dumps the defaults compiled into whatever herdr binary is currently
# installed locally — it does not fetch from upstream. Run `herdr update` first
# if you want the dump to reflect the latest release.
#
# This is the chezmoi-managed source for herdr's config. If you make a live config
# change and confirm it actually works, port it back here (edit-source-first — not
# `chezmoi re-add`, since this file is templated) and run `chezmoi apply`.
# Don't port over changes you haven't verified.

onboarding = false
[update]
{{- if eq .chezmoi.os "windows" }}
# Explicit — the channel default is per-build (preview builds default to
# "preview", stable builds default to "stable"), not per-OS. Confirmed via
# `herdr --default-config`. The stable build was what got installed here,
# so it defaulted to "stable" until this override; want preview on Windows.
channel = "preview"
{{- else }}
# channel unset — defaults to stable. That's what we want here: Linux is
# AUR-managed, `herdr update` would clobber the pacman-owned binary.
{{- end }}

[terminal]
{{- if eq .chezmoi.os "windows" }}
# Hardcoded — herdr's Windows support is still beta and doesn't actually read
# $SHELL there (confirmed by testing: set + rebooted, still fell back to
# PowerShell 5). $SHELL works fine on Linux/Mac so it's left to the fallback
# there; see README for the full story.
default_shell = "C:\\Program Files\\PowerShell\\7\\pwsh.exe"
{{- else }}
# default_shell unset — falls back to $SHELL, which works correctly on Unix.
{{- end }}
new_cwd = "follow"

[keys]
{{- if eq .machine_kind "vps" }}
# ctrl+x collides with common shell/tmux-in-SSH usage on the VPS -- ctrl+a instead.
prefix = "ctrl+a"
{{- else }}
prefix = "ctrl+x"
{{- end }}
# prefix+ctrl+tab / prefix+ctrl+shift+tab for agent switching didn't work either —
# Windows Terminal still consumes ctrl+tab before herdr sees it, even with the
# prefix. Left unbound rather than binding to something that silently does nothing.
next_tab = "prefix+tab"
previous_tab = "prefix+shift+tab"
settings = "prefix+comma"
workspace_picker = "prefix+shift+w"
rename_workspace = "prefix+shift+e"
previous_workspace = "prefix+w"
next_workspace = "prefix+s"

{{- if eq .chezmoi.os "windows" }}

[[keys.command]]
key = "prefix+n"
type = "shell"
command = 'pwsh -NoProfile -File "C:\Users\User\scripts\herdr-new-cc-tab.ps1"'
{{- end }}

# herdr-drovr plugin (AVGVSTVS96/herdr-drovr, see desired-plugins.txt) keybinds.
[[keys.command]]
key = "prefix+M"
type = "plugin_action"
command = "drovr.move-tab"
description = "move tab to workspace"

{{- if eq .machine_kind "arch" }}
# drovr's move-pane replaced here (this machine only) by a local test of
# herdr-pane-mover (osamahbeig/herdr-pane-mover, 13 stars on GitHub), linked
# from ~/programming/herdr-plugins/herdr-pane-mover. Tried herdr-pane-tools
# first (JordanBelfort1/herdr-pane-tools, platform-patched to add linux) but
# it only moved a pane to an EXISTING tab; pane-mover has full drovr parity
# (move to existing/new tab, existing/new workspace) plus re-split and swap,
# and its own manifest already declares platforms = ["macos","linux"] --
# no patch needed for this machine. Confirmed working on Linux 2026-10-06.
# Windows untested so far (not linked there yet, and its manifest would need
# "windows" added to platforms first). Not in desired-plugins.txt since it's
# a link, not a github install -- don't expect this plugin to exist on other
# machines until that's done.
[[keys.command]]
key = "prefix+m"
type = "plugin_action"
command = "osamahbeig.pane-mover.open"
description = "move pane (pane-mover, local linux test)"
{{- else }}
#[[keys.command]]
#key = "prefix+m"
#type = "plugin_action"
#command = "drovr.move-pane"
#description = "move pane to tab"
{{- end }}

[ui]
agent_panel_sort = "priority"
pane_gaps = false
pane_outer_borders = false
# Right-aligned tab bar status (PR #2586, merged 2026-08-09).
tab_bar_right = [
  { type = "zoom" },
  { type = "datetime", format = "%H:%M" },
]
tab_bar_right_separator = " · "

status_indicators = "symbols"
show_agent_labels_on_pane_borders = true
[ui.toast]
delivery = "herdr"

[theme]
name = "terminal"
auto_switch = false

[experimental]
kitty_graphics = true
