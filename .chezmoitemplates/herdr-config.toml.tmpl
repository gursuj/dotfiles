onboarding = false
# Run `herdr --default-config` to see all available settings and their defaults.
# This dumps the defaults compiled into whatever herdr binary is installed.
#
# Merged 2026-11-07 for the ThinkPad: Omarchy's shipped config
# (/usr/share/omarchy/config/herdr/config.toml, a tmux mirror) is the base, plus
# the IdeaPad's additive settings (pane-mover plugin, pickers, agent panel sort,
# symbol indicators, kitty graphics). Omarchy-owned keybinds win where they
# collide, since herdr here is meant to behave like Omarchy's tmux.
#
# If you change the live config and confirm it works, port it back here (edit
# source first -- not `chezmoi re-add`, since this file is templated).

# Mirrors the Omarchy tmux config in config/tmux/tmux.conf
# tmux session -> herdr workspace, tmux window -> herdr tab, tmux pane -> herdr pane

[theme]
# tmux ran on the terminal's own palette (bg=default, fg=default, ANSI blue accents)
name = "terminal"
auto_switch = false

# No [theme.custom] here on purpose. The sidebar/main-pane divider is a "│" drawn
# in the `surface_dim` colour (herdr src/client/shell/render.rs), so overriding
# surface_dim (it was "black") made it invisible. panel_bg = "reset" (see-through
# tab bar) was dropped with it: it is what made surface_dim double as the active
# tab's text colour, forcing that override.
# Cost: the tab bar is opaque instead of see-through under Glassy windows. Getting
# that back needs a surface_dim that works as both divider and tab-text colour.

[terminal]
# Matches -c "#{pane_current_path}" on every split, window, and session
{{- if eq .chezmoi.os "windows" }}
# Hardcoded: herdr's Windows support does not read $SHELL reliably (confirmed by
# testing -- it fell back to PowerShell 5), so it is explicit there.
default_shell = "C:\\Program Files\\PowerShell\\7\\pwsh.exe"
{{- end }}
new_cwd = "follow"

[keys]
{{- if eq .machine_kind "vps" }}
# ctrl+x collides with shell usage when herdr runs over SSH -- ctrl+a there.
prefix = "ctrl+a"
{{- else }}
prefix = "ctrl+x"
{{- end }}

# Config and help
reload_config = "prefix+shift+r"
help = "prefix+?"
detach = "prefix+q"

# Copy mode
copy_mode = "prefix+["

# Panes
# prefix+h/j/k/l is pane focus (below), so the h split moved to herdr's own
# default, prefix+minus.
split_horizontal = ["prefix+minus", "alt+enter"]
split_vertical = ["prefix+v", "alt+shift+enter"]
close_pane = ["prefix+x", "alt+esc"]
zoom = "prefix+z"
last_pane = "prefix+;"

focus_pane_left = ["prefix+h", "ctrl+alt+left"]
focus_pane_down = ["prefix+j", "ctrl+alt+down"]
focus_pane_up = ["prefix+k", "ctrl+alt+up"]
focus_pane_right = ["prefix+l", "ctrl+alt+right"]

resize_mode = ["prefix+r", "prefix+ctrl+left", "prefix+ctrl+down", "prefix+ctrl+up", "prefix+ctrl+right"]

# Like resize-pane on C-M-S-arrows
resize_pane_left = "ctrl+alt+shift+left"
resize_pane_down = "ctrl+alt+shift+down"
resize_pane_up = "ctrl+alt+shift+up"
resize_pane_right = "ctrl+alt+shift+right"

# No tmux equivalent; herdr's default prefix+shift+p is taken by previous session
rename_pane = "prefix+shift+o"

# Windows -> tabs
new_tab = "prefix+c"
# herdr's own defaults: prefix+r would shadow resize_mode's default and
# prefix+k is pane focus up.
rename_tab = "prefix+shift+t"
close_tab = "prefix+shift+x"
switch_tab = ["prefix+1..9", "alt+1..9"]
previous_tab = ["prefix+p", "alt+left", "prefix+shift+tab"]
next_tab = ["prefix+n", "alt+right", "prefix+tab"]

# herdr's defaults put pane cycling on prefix+tab / prefix+shift+tab; both keys
# are wanted for tab navigation here, and a key can only drive one action, so
# pane cycling moves to tmux's own prefix+o (next) and is unbound in the other
# direction (tmux has no previous-pane bind either; prefix+; jumps to the last
# pane, bound as last_pane above).
cycle_pane_next = "prefix+o"
cycle_pane_previous = ""

# Like swap-window -t -1/+1 on M-S-Left/Right
move_tab_previous = "alt+shift+left"
move_tab_next = "alt+shift+right"

# Sessions -> workspaces
new_workspace = "prefix+shift+c"
# reload_config sits on prefix+shift+r, so renaming a workspace moved to shift+e
# on every machine (it used to be shift+r).
rename_workspace = "prefix+shift+e"
close_workspace = "prefix+shift+k"
{{- if eq .chezmoi.os "windows" }}
previous_workspace = "prefix+w"
{{- else }}
previous_workspace = ["prefix+shift+p", "alt+up"]
{{- end }}
{{- if eq .chezmoi.os "windows" }}
next_workspace = "prefix+s"
{{- else }}
next_workspace = ["prefix+shift+n", "alt+down"]
{{- end }}

# Additive (from the IdeaPad config): settings picker + workspace picker
settings = "prefix+comma"
workspace_picker = "prefix+shift+w"

# herdr-pane-mover (gursuj fork, see desired-plugins.txt): move pane to an
# existing/new tab or workspace, plus re-split and swap.
[[keys.command]]
key = "prefix+m"
type = "plugin_action"
command = "osamahbeig.pane-mover.open"
description = "move pane (pane-mover)"

[ui]
accent = "blue"

# tmux drew single-line dividers between adjacent panes and no outer frame
pane_gaps = false
pane_outer_borders = false

# Scrollbars on (herdr's default). tmux had none, but they are handy with
# mouse_capture on; costs one column beside each pane.
pane_scrollbars = true

# kill-window and kill-session never asked
confirm_close = false

# automatic-rename gave windows a name without prompting
prompt_new_tab_name = false

# set -g mouse on. Back on: herdr's mouse UI (tab click, drag-select, its own
# scrollback) is worth more than middle-click paste, which herdr swallows -- use
# a terminal paste instead while mouse capture is on.
mouse_capture = true

# zoom flag + clock (main-branch behaviour; the tmux #h host readout was dropped)
tab_bar_right = [{ type = "zoom" }, { type = "datetime", format = "%H:%M" }]
tab_bar_right_separator = " · "

# set -g set-titles on / set -g set-titles-string '#h:#W', where tmux's #W was
# the basename of the pane cwd. This is what Hyprland shows in the group bar,
# and it resolves on the server so remote sessions name the remote host.
window_title = "{hostname}: {workspace}"

# Additive (from the IdeaPad config): agent-aware pane ordering, symbol indicators
agent_panel_sort = "priority"
status_indicators = "symbols"
show_agent_labels_on_pane_borders = true

[ui.toast]
delivery = "herdr"

[experimental]
kitty_graphics = true

{{- if eq .chezmoi.os "windows" }}

# New agent tab helper (Documents/PowerShell/herdr-new-cc-tab.ps1)
[[keys.command]]
key = "prefix+n"
type = "shell"
command = 'pwsh -NoProfile -File "C:\Users\User\scripts\herdr-new-cc-tab.ps1"'
{{- end }}
