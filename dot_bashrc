#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias nv=nvim
PS1='[\u@\h \W]\$ '

# Auto-fix `wp` inside Local by Flywheel site shells (DB socket mismatch)
[ -f ~/programming/local-wpcli/wp-shell-integration.sh ] && source ~/programming/local-wpcli/wp-shell-integration.sh
