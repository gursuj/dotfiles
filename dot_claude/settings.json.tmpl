{
  "permissions": {
    "allow": [
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.huggingface.co)",
      "WebFetch(domain:github.com)",
      "Bash(agent-browser open *)",
      "Bash(agent-browser wait *)",
      "Bash(agent-browser close *)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "skillOverrides": {
    "find-skills": "off",
    "frontend-design": "off",
    "skill-creator": "off",
    "wp-plugin-development": "off",
    "wp-rest-api": "off",
    "wp-wpcli-and-ops": "off"
  },
  "hooks": {
{{- if eq .chezmoi.os "windows" }}
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"C:\\Users\\User\\.claude\\hooks\\claude-notifier-on-permission.ps1\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"C:\\Users\\User\\.claude\\hooks\\claude-notifier-on-question.ps1\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\User\\.claude\\hooks\\herdr-agent-state.ps1\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"C:\\Users\\User\\.claude\\hooks\\claude-notifier-on-stop.ps1\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"C:\\Users\\User\\.claude\\hooks\\claude-notifier-on-subagent-stop.ps1\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"C:\\Users\\User\\.claude\\hooks\\claude-notifier-on-prompt.ps1\""
          }
        ]
      }
    ]
{{- else }}
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
{{- end }}
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "wp-creative@wpc-os": true,
    "figma@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "wpc-os": {
      "source": {
        "source": "github",
        "repo": "wpcreativeagency/wpc-os"
      }
    }
  },
  "outputStyle": "Terse",
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "vim",
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(ssh:*) on any VPS host — per user's global instruction, never run SSH directly against a VPS; always hand back commands for the user to run themselves"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public — this repo (D:\\claude-sandbox) has no remotes configured, so treat as local-only/private",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: unknown — no git remotes configured in this repo, and origin/HEAD unset",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo only (D:\\claude-sandbox) — no remotes configured, so no remote source control host is established",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: gtd.gurungsujal.com.np (Mindwtr Cloud GTD, self-hosted on VPS, REST API over HTTPS with bearer token in MINDWTR_API_TOKEN)",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (WordPress-centric, per user global CLAUDE.md), with dotfiles/chezmoi management and personal GTD workflow",
      "**Trusted repo**: D:\\claude-sandbox — no remotes configured; this repo currently has 0 tracked files",
      "**Org-specific CLIs**: herdr (herdr.dev — frequently used local dev tool), chezmoi (dotfile management), wpc-push / wpc-push.ps1 (seen in shell history, likely WPC OS deployment helper)",
      "**Never run SSH directly against any VPS** — give the user commands to run themselves instead of executing ssh/remote commands, unless the user explicitly says otherwise in that specific message",
      "**WPC OS routine**: repo cloned at D:/wpc-os is a separate checkout from this project — only `_my-work/` under it is editable from a session; everything else there is shared org content and read-only"
    ]
  }
}
