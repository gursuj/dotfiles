function wlan-scan() {
	iwctl station wlan0 scan
	# scan is async - poll until it's done (or timeout) before returning,
	# else a connect right after this can fail with "invalid network name"
	for _ in $(seq 1 20); do
		iwctl station wlan0 show | grep -q "Scanning.*no" && return
		sleep 0.5
	done
}
alias iw2g="wlan-scan; iwctl station wlan0 connect sujal1058_2"
alias iw5g="wlan-scan; iwctl station wlan0 connect sujal1058_5"
alias iwcg="wlan-scan; iwctl station wlan0 connect 'CG net5'"
alias iwhot="wlan-scan; iwctl station wlan0 connect POCO" # mobile hotspot
