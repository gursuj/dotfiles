## Background color to use when executing `toggle_custom_color`
### based on tokyo-night
custom_background_color 0.102 0.106 0.149
custom_text_color 0.753 0.792 0.961
# custom_text_color 0.847 0.871 0.914
custom_color_mode_empty_background_color 0.102 0.106 0.149

startup_commands toggle_custom_color
search_url_s	https://searx.cronyakatsuki.xyz/search?q=

# when new file is opened
should_launch_new_window				1

page_separator_width 2
page_separator_color	0.0 0.0 0.0

single_click_selects_words 1
collapsed_toc 1
add_newlines_when_copying_text 1
