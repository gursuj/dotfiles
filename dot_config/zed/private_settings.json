// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Decrease the horizontal indent size of files & folders in the project
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    }
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left",
    "tree_view": false,
  },
  "context_servers": {},
  "scroll_sensitivity": 2.0,
  "project_panel": {
    "dock": "left",
    "indent_size": 12,
  },
  "colorize_brackets": true,
  "agent": {
    "dock": "right",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5",
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
    },
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "on_yank",
  },
  "relative_line_numbers": "enabled",
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Soft",
    "dark": "Gruvbox Dark",
  },
  "tab_size": 4,
  "hard_tabs": false,
  "soft_wrap": "editor_width",
  "languages": {
    "TypeScript": {
      "language_servers": ["angular", "..."],
    },
    "PHP": {
      // "language_servers": ["phpactor", "..."],
      "language_servers": ["intelephense", "!phpactor", "..."],
    },
    "JSONC": {
      "tab_size": 2,
    },
    "HTML": {
      "indent_guides": {
        "coloring": "indent_aware",
      },
      "language_servers": [
        "vscode-html-language-server",
        "!prettier",
        "angular",
        "...",
      ],
      "formatter": "language_server",
      // "formatter": "prettier",
      // doesn't work inside angular project for some reason
      "tab_size": 4,
      "hard_tabs": false,
    },
    "Markdown": {
      // do not remove any trailing whitespace since line breaks in
      // lists (without adding a new punctuation) rely on whitespaces.
      "remove_trailing_whitespace_on_save": false,
    },
  },
  // "prettier": {
  //   "tabwidth": 8,
  //   "singleattributeperline": false
  // },
  "lsp": {
    "vscode-html-language-server": {
      "settings": {
        // workaround to prevent html lsp error about validproperties
        "css": {
          "lint": {
            "validProperties": {},
          },
        },
        "html": {
          "format": {
            // Disable formatting inside <script>
            "contentUnformatted": "script",
          },
        },
      },
    },
  },
}
