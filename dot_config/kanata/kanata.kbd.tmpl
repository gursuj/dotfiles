;; Caps Lock becomes a layer key: tap = Esc, hold = an Fn-style layer.
;; Physical CapsLock is fully intercepted here, so its lock/toggle behavior
;; is gone unless remapped back explicitly.

(defcfg
  process-unmapped-keys no
{{- if eq .chezmoi.os "windows" }}
  ;; Avoids false "Unexpected keycode" errors when other apps (e.g. WTQ's
  ;; global hotkey hook) race with kanata's own key-state sync on Windows.
  ;; On 1.12.0 (installed) this is a bool (no/yes). Kanata PR #2122
  ;; (commit def6432c, 2026-07-26) changes it to an enum: none |
  ;; clear-kanata-states | clear-kanata-and-os-states. Not in any tagged
  ;; release yet (newest tag v1.12.1-prerelease-1 predates it) — once
  ;; installed kanata is past that point, change this value to `none`.
  ;; NOTE: on 1.12.0 this setting only guards the "Windows key pressed but
  ;; not in kanata" direction. The "kanata key pressed but not in Windows"
  ;; check (the one actually firing as "Clearing kanata states: Kb1" below)
  ;; is hardcoded on in this version — this setting does not silence it.
  ;; Windows-OS-only workaround (Microsoft Windows, not app windows) --
  ;; irrelevant on Linux, where this key-state race doesn't exist.
  windows-sync-keystates no
{{- end }}
)

;; Previous setup: hold Caps for an arrow layer on WASD. Commented out —
;; this keyboard's own hardware Fn+WASD already sends arrows, so kanata
;; doing the same thing was redundant. Caps now drives an Fn-style layer
;; instead (see below): hold Caps + number row for F1-F12.
;; (defsrc
;;   caps
;;   w a s d
;; )
;;
;; (deflayer base
;;   (tap-hold 200 200 esc (layer-while-held arrows))
;;   w a s d
;; )
;;
;; (deflayer arrows
;;   _
;;   up left down right
;; )

{{- if eq .chezmoi.os "windows" }}
;; "1" is deliberately left out of defsrc below (was included, mapped to
;; F1 on the fn layer). WTQ's Alt+1 global hotkey races with kanata's
;; always-on "kanata key pressed but not in Windows" keystate check on
;; 1.12.0 (see NOTE above) and repeatedly triggers a false "Clearing
;; kanata states: Kb1" error. Since process-unmapped-keys is no, dropping
;; "1" from defsrc makes kanata pass it through untouched instead of
;; tracking it, avoiding the check entirely. Cost: Caps+1 no longer sends
;; F1. Once kanata ships the real fix (windows-sync-keystates none, see
;; NOTE above) this should be reverted: put "1" back in defsrc/deflayers
;; below and rely on that setting instead.
;; Windows-OS-only workaround -- WTQ (the app racing here) is Windows-only,
;; so Linux keeps "1" mapped normally below.
(defsrc
  caps
  2 3 4 5 6 7 8 9 0 - =
)

(deflayer base
  (tap-hold 200 200 esc (layer-while-held fn))
  2    3    4    5    6    7    8    9    0    -    =
)

(deflayer fn
  _
  f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
)
{{- else }}
(defsrc
  caps
  1 2 3 4 5 6 7 8 9 0 - =
)

(deflayer base
  (tap-hold 200 200 esc (layer-while-held fn))
  1    2    3    4    5    6    7    8    9    0    -    =
)

(deflayer fn
  _
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
)
{{- end }}
