# Ghostty config, merged: Omarchy's shipped defaults + personal additions.
#
# Omarchy's own copy lives at /usr/share/omarchy/config/ghostty/config and is
# installed once; `omarchy-refresh-config ghostty/config` would overwrite this
# file, so don't run that on this machine (see learnings.md).
#
# The only Omarchy-specific line is the theme include at the top, which is
# gated so this file also works on a machine without Omarchy: there it is
# omitted and Ghostty falls back to whatever theme it is configured with.

{{ if lookPath "omarchy" -}}
# Dynamic theme colours, regenerated by omarchy-theme-set for every theme.
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

{{ end -}}
# Font
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 9

# Window
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

# ---------------------------------------------------------------------------
# Personal additions (from the IdeaPad config)
# ---------------------------------------------------------------------------
# Selecting text copies it straight to the clipboard.
copy-on-select = "clipboard"
# Ctrl+Enter is a fullscreen toggle by default; freed up for TUIs.
keybind = ctrl+enter=unbind
# Middle click pastes the system clipboard. Ghostty's default is primary-paste,
# which looks dead if you copy with Ctrl+C instead of selecting text. Note that
# Hyprland's own misc:middle_click_paste must stay off (looknfeel.lua) or the
# compositor pastes into the *focused* window instead of the one you clicked.
middle-click-action = clipboard-paste
