# Mime defaults, merged for the ThinkPad (2026-11-07).
# Omarchy's base + the IdeaPad preferences that still have an installed handler.
#
# Dropped from the IdeaPad version: sioyek (not installed -- PDFs stay on Evince),
# onlyoffice, nomacs (swayimg handles NEF/CR2 now), qBittorrent, FontViewer, zed,
# nvim for text/plain and x-php, Waterfox, and the dead HEY / Superwhisper
# handlers (both apps are gone).

[Default Applications]
text/html=firefox.desktop
x-scheme-handler/http=firefox.desktop
x-scheme-handler/https=firefox.desktop
x-scheme-handler/about=firefox.desktop
x-scheme-handler/unknown=firefox.desktop
image/avif=swayimg.desktop
image/bmp=swayimg.desktop
image/gif=swayimg.desktop
image/heic=swayimg.desktop
image/heif=swayimg.desktop
image/jpeg=swayimg.desktop
image/jpg=swayimg.desktop
image/jxl=swayimg.desktop
image/pbm=swayimg.desktop
image/pjpeg=swayimg.desktop
image/png=swayimg.desktop
image/svg+xml=swayimg.desktop
image/tiff=swayimg.desktop
image/webp=swayimg.desktop
image/x-bmp=swayimg.desktop
image/x-canon-cr2=swayimg.desktop
image/x-exr=swayimg.desktop
image/x-nikon-nef=swayimg.desktop
image/x-png=swayimg.desktop
image/x-portable-anymap=swayimg.desktop
image/x-portable-bitmap=swayimg.desktop
image/x-portable-graymap=swayimg.desktop
image/x-portable-pixmap=swayimg.desktop
image/x-targa=swayimg.desktop
image/x-tga=swayimg.desktop
video/mp4=mpv.desktop
video/x-matroska=mpv.desktop
video/quicktime=mpv.desktop
video/webm=mpv.desktop
x-scheme-handler/mindwtr=mindwtr-handler.desktop
x-scheme-handler/claude-cli=claude-code-url-handler.desktop

