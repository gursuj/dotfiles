{{- if eq .chezmoi.os "windows" -}}
# Windows: no shebang support. Map .sh -> sh (git-bash) or chezmoi execs it raw and fails.
[interpreters.sh]
    command = "sh"

[data]
    sandbox_dir = 'D:\claude-sandbox'
{{- end -}}

{{- $diffCmd := "diff" -}}
{{- if and (eq .chezmoi.os "windows") (not (lookPath "diff")) -}}
  {{- $diffCmd = "" -}}
{{- end -}}

{{- if $diffCmd }}
[diff]
    command = {{ $diffCmd | quote }}
    args = ["--color=always", "--strip-trailing-cr", "{{ "{{ .Destination }}" }}", "{{ "{{ .Target }}" }}"]
{{- end }}

{{- /* Windows is a single known device -- gated via .chezmoi.os instead.
   Linux boxes (arch laptop vs Ubuntu VPS) need finer-grained conditionals,
   so ask once per machine and cache the answer in that machine's own local
   chezmoi.toml (this template is synced everywhere; the generated config
   it produces at ~/.config/chezmoi/chezmoi.toml is per-machine and never
   committed). */ -}}
{{- if ne .chezmoi.os "windows" }}
{{- $machineKind := promptChoiceOnce . "machine_kind" "Machine kind" (list "arch" "vps" "wpc") }}
[data]
    machine_kind = {{ $machineKind | quote }}
    sandbox_dir = {{ printf "%s/programming/claude-sandbox" .chezmoi.homeDir | quote }}
{{- end }}
