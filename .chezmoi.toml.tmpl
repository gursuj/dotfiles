{{- /* Hoisted above everything else: machine_kind needs to be known before the
   age block below (to decide whether to skip it on the vps) and is reused
   again later for the non-Windows [data] table, so it's only prompted once. */ -}}
{{- $machineKind := "wpc" -}}
{{- if ne .chezmoi.os "windows" -}}
{{- $machineKind = promptChoiceOnce . "machine_kind" "Machine kind" (list "arch" "vps" "wpc") -}}
{{- end -}}

{{- if ne $machineKind "vps" }}
# age encryption for secrets tracked in the (public) repo, e.g. cliamp's
# config.toml. Ciphertext lives in the repo; the private key never does --
# it stays local-only at the path below (outside the chezmoi source dir).
# Must stay above every [table] header in this file -- TOML has no way to
# "exit" a table once one is opened, so a bare key placed after any table
# header silently becomes nested under that table instead of the top-level
# key chezmoi expects. Skipped entirely on the vps: no cliamp there, so no
# reason for the private key to exist on that box.
encryption = "age"
[age]
    identity = {{ if eq .chezmoi.os "windows" -}}
    'C:\Users\User\.config\chezmoi\key.txt'
    {{- else -}}
    {{ printf "%s/.config/chezmoi/key.txt" .chezmoi.homeDir | quote }}
    {{- end }}
    recipient = "age1tjanpx59mlslph4tewx3ckydpf7766kmgf7x9nl3p30pvca72uksd607wz"
{{ end }}
{{- if eq .chezmoi.os "windows" -}}
# Windows: no shebang support. Map .sh -> sh (git-bash) or chezmoi execs it raw and fails.
[interpreters.sh]
    command = "sh"

# Same problem for the .py.tmpl script (browser user.js sync) -- needs python3
# on PATH. See README "Dependencies" for what to install if this errors.
[interpreters.py]
    command = "python"

[data]
    machine_kind = "wpc"
    sandbox_dir = 'D:\claude-sandbox'
{{- end -}}

{{- $diffCmd := "diff" -}}
{{- if and (eq .chezmoi.os "windows") (not (lookPath "diff")) -}}
  {{- $diffCmd = "" -}}
{{- end -}}

{{- if $diffCmd }}
{{/* chezmoi diffs a script (e.g. run_onchange_*) against its own hardcoded Windows null-
   device sentinel "NUL:" (colon included) when there's no destination file on disk. Git for
   Windows' diff.exe only understands "/dev/null", not "NUL:", and errors with
   "diff: NUL:: No such file or directory". Route through sh -c to swap that sentinel for
   /dev/null before calling the real diff -- harmless on non-Windows since Destination/Target
   never equal "NUL:" there. */}}
[diff]
    command = "sh"
    args = ["-c", "a=$1; b=$2; label=$a; [ \"$label\" = 'NUL:' ] && label=$b; printf '\\n\\033[1m%s\\033[0m\\n' \"$label\"; [ \"$a\" = 'NUL:' ] && a=/dev/null; [ \"$b\" = 'NUL:' ] && b=/dev/null; exec {{ $diffCmd }} --color=always --strip-trailing-cr \"$a\" \"$b\"", "diffwrap", "{{ "{{ .Destination }}" }}", "{{ "{{ .Target }}" }}"]
    exclude = ["scripts"]
{{- else }}
[diff]
    exclude = ["scripts"]
{{- end }}

{{- /* Windows is a single known device -- gated via .chezmoi.os instead.
   Linux boxes (arch laptop vs Ubuntu VPS) need finer-grained conditionals,
   so ask once per machine and cache the answer in that machine's own local
   chezmoi.toml (this template is synced everywhere; the generated config
   it produces at ~/.config/chezmoi/chezmoi.toml is per-machine and never
   committed). */ -}}
{{- if ne .chezmoi.os "windows" }}
[data]
    machine_kind = {{ $machineKind | quote }}
    sandbox_dir = {{ printf "%s/programming/claude-sandbox" .chezmoi.homeDir | quote }}
{{- end }}
